---
import { render } from 'astro:content';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import ProseStyles from '../components/ProseStyles.astro';
import TocScript from '../components/TocScript.astro';
import { statusMeta, type Project } from '../lib/projects';
import { shareImage } from '../lib/posts';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const { entry, url } = project;
const { title, description, image, year, lang, status, repo, site, post } = entry.data;

const siteTitle = 'Scott Chacon';
const shareImg = shareImage(image);
const shareDesc = description.replace(/\s+/g, ' ').trim().slice(0, 200);
const { label, cls } = statusMeta(status);

const { Content } = await render(entry);
---
<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="author" content="Scott Chacon" />
  <meta name="description" content={shareDesc} />
  <link rel="canonical" href={`https://scottchacon.com${url}`} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={siteTitle} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={shareDesc} />
  <meta property="og:image" content={`https://scottchacon.com${shareImg}`} />
  <meta property="og:url" content={`https://scottchacon.com${url}`} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@chacon" />
  <meta name="twitter:creator" content="@chacon" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={shareDesc} />
  <meta name="twitter:image" content={`https://scottchacon.com${shareImg}`} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;900&family=Roboto+Mono:wght@300;400&family=Roboto:wght@100;300;400;500;700&family=Source+Serif+4:opsz,wght@8..60,300;8..60,400&display=swap"
    rel="stylesheet"
  />
  <title>{title} - {siteTitle}</title>
  <ProseStyles />

  <!-- Privacy-friendly analytics by Plausible -->
  <script async src="https://plausible.io/js/pa-L3isa8WSnas7pGAEYbsHg.js"></script>
  <script is:inline>
    window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
    plausible.init()
  </script>
</head>

<body>
<div class="flex-auto pb-20">
  <SiteHeader backUrl="/projects/" backText="all projects" />
  <div class="sm:px-8 mt-9">
    <div class="mx-auto w-full max-w-7xl lg:px-8">
      <div class="relative px-4 sm:px-8 lg:px-12">
        <div class="mx-auto max-w-5xl lg:flex lg:justify-between lg:gap-12 lg:mt-16">
          <article class="w-full lg:max-w-2xl min-w-0">
            <h1 class="font-head text-4xl sm:text-5xl tracking-tight text-zinc-900 dark:text-zinc-100">
              {title}
            </h1>
            <div class="mt-4 flex flex-wrap items-center gap-2 text-sm tracking-tight text-zinc-400">
              <span class={`inline-flex rounded-full px-2 py-0.5 text-[0.65rem] font-semibold uppercase tracking-widest ${cls}`}>{label}</span>
              {lang && <><span class="font-mono text-zinc-500 dark:text-zinc-400">{lang}</span><span aria-hidden="true">·</span></>}
              <span>{year}</span>
            </div>
            <p class="mt-5 text-lg leading-8 text-zinc-600 dark:text-zinc-400">{description}</p>
            <div id="post-content" class="prose-body font-blog font-lg leading-7 flex flex-col mt-8 space-y-4">
              <Content />
            </div>
          </article>
          <aside id="toc-wrap" class="hidden lg:block flex-none w-60">
            <div class="sticky top-12">
              <img src={image} alt="" class="w-full rounded-xl mb-6 ring-1 ring-zinc-900/5 dark:ring-white/10" />
              {(repo || site || post) && (
                <div class="mb-6 flex flex-col gap-2 text-sm">
                  {site && <a href={site} class="text-blue-600 hover:underline">Website <span aria-hidden="true">↗</span></a>}
                  {repo && <a href={repo} class="text-blue-600 hover:underline">Source on GitHub <span aria-hidden="true">↗</span></a>}
                  {post && <a href={post} class="text-blue-600 hover:underline">Related post <span aria-hidden="true">→</span></a>}
                </div>
              )}
              <nav id="toc-nav">
                <div class="text-xs font-semibold uppercase tracking-widest text-zinc-400 mb-3">On this page</div>
                <div class="toc" id="toc"></div>
              </nav>
            </div>
          </aside>
        </div>

        <!-- Links again at the end of the article, for the narrow layout where
             the right rail is hidden entirely. -->
        <div class="mx-auto max-w-5xl lg:hidden mt-10">
          <div class="flex flex-wrap gap-4 text-sm border-t border-zinc-200 dark:border-zinc-800 pt-6">
            {site && <a href={site} class="text-blue-600 hover:underline">Website <span aria-hidden="true">↗</span></a>}
            {repo && <a href={repo} class="text-blue-600 hover:underline">Source on GitHub <span aria-hidden="true">↗</span></a>}
            {post && <a href={post} class="text-blue-600 hover:underline">Related post <span aria-hidden="true">→</span></a>}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<TocScript />
</body>
</html>
