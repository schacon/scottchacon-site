---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'Writing, talks, random photos and other things from Scott Chacon.',
} = Astro.props;
const siteTitle = 'Scott Chacon';
---
<!DOCTYPE html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="author" content="Scott Chacon" />
    <meta name="description" content={description} />

    <meta property="og:title" content="My homepage" />
    <meta property="og:image" content="//scottchacon.com/assets/images/title.png" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@chacon" />
    <meta name="twitter:title" content="Scott Chacon's homepage" />
    <meta name="twitter:description" content="Writing, talks, randomness from Scott on the internet." />
    <meta name="twitter:image" content="//scottchacon.com/assets/images/title.png" />

    <link rel="alternate" type="application/rss+xml" href="/atom.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,600;0,700;0,800;1,400&family=Inter:wght@100;200;300;400;500;600;700;900&family=Roboto+Mono:wght@300;400&display=swap"
      rel="stylesheet"
    />
    <title>{title} - {siteTitle}</title>

    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://plausible.io/js/pa-L3isa8WSnas7pGAEYbsHg.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
