---
interface Props {
  backUrl?: string;
  backText?: string;
}
const { backUrl = '/', backText = 'back home' } = Astro.props;
---
<div class="border-b border-zinc-200 dark:border-zinc-800">
  <div class="mx-auto w-full max-w-7xl lg:px-8">
    <div class="relative px-4 sm:px-8 lg:px-12">
      <div class="mx-auto max-w-2xl lg:max-w-5xl flex items-center justify-between py-4">
        <a class="site-mark" href="/">scottchacon.com</a>
        <a class="back-link" href={backUrl}><span aria-hidden="true">←</span> {backText}</a>
      </div>
    </div>
  </div>
</div>
