---
import { categoryMeta, formatShortDate, type Post } from '../lib/posts';

interface Props {
  post: Post;
  variant: 'hero' | 'compact';
}
const { post, variant } = Astro.props;
const { entry, category, url, date } = post;
const { title, image, excerpt } = entry.data;
const { tag, tagcls } = categoryMeta(category);
const shortDate = formatShortDate(date);

function truncate(s: string | undefined, n: number): string {
  const t = (s ?? '').replace(/\s+/g, ' ').trim();
  return t.length > n ? t.slice(0, n).replace(/\s+\S*$/, '') + '…' : t;
}
---
{variant === 'hero' ? (
  <a href={url} class="group grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-12 items-center">
    <div>
      <div class="overflow-hidden rounded-2xl aspect-[16/10] bg-zinc-100 dark:bg-zinc-800 ring-1 ring-zinc-900/5 dark:ring-white/10">
        <img src={image} alt="" loading="lazy" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
      </div>
    </div>
    <div>
      <div class="flex items-center gap-3">
        <span class={`inline-flex rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-widest ${tagcls}`}>{tag}</span>
        <time class="text-sm tracking-tight text-zinc-400">{shortDate}</time>
      </div>
      <h2 class="font-head mt-5 text-3xl sm:text-4xl lg:text-5xl tracking-tight text-zinc-900 dark:text-zinc-100 transition-colors group-hover:text-blue-600">{title}</h2>
      <p class="mt-4 text-lg leading-8 text-zinc-600 dark:text-zinc-400">{truncate(excerpt, 160)}</p>
      <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-blue-600">Read <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span></span>
    </div>
  </a>
) : (
  <a href={url} class="group flex gap-4 sm:gap-5 items-start">
    <div class="flex-none w-28 sm:w-36 overflow-hidden rounded-xl aspect-[3/2] bg-zinc-100 dark:bg-zinc-800 ring-1 ring-zinc-900/5 dark:ring-white/10">
      <img src={image} alt="" loading="lazy" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
    </div>
    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-2">
        <span class={`inline-flex rounded-full px-2 py-0.5 text-[0.65rem] font-semibold uppercase tracking-widest ${tagcls}`}>{tag}</span>
        <time class="text-xs tracking-tight text-zinc-400">{shortDate}</time>
      </div>
      <h3 class="font-head mt-1.5 text-lg sm:text-xl leading-tight tracking-tight text-zinc-900 dark:text-zinc-100 transition-colors group-hover:text-blue-600">{title}</h3>
      <p class="mt-1 text-sm leading-6 text-zinc-500 dark:text-zinc-400">{truncate(excerpt, 105)}</p>
    </div>
  </a>
)}
